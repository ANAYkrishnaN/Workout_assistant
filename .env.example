# Copy to .env.local and fill in your values. Restart dev server after changing.
# Next.js loads .env.local automatically from project root.
# For production/Docker: use AWS Secrets Manager or Parameter Store; do not commit real values.

# -----------------------------------------------------------------------------
# Required: MongoDB (users, profiles, auth, diet plan persistence)
# -----------------------------------------------------------------------------
NEXT_MONGODB_URI=mongodb://localhost:27017

# -----------------------------------------------------------------------------
# FastAPI backend (YOLO /detect, /predict-diet, /predict-hydration, /posture/*)
# Next.js API routes proxy to this URL. Default works when backend runs on same machine.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Optional: OpenWeather (for hydration weather-based adjustments)
# Frontend: NEXT_PUBLIC_* (client can request by city). Backend: OPENWEATHER_API_KEY (server-side fetch by city).
# If unset: frontend can use Open-Meteo fallback; backend uses temp/humidity from request body.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_OPENWEATHER_API_KEY=
# OPENWEATHER_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Gemini (Chatbot only; not used by diet, detect, or posture)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=
# NEXT_PUBLIC_GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Sentry (error reporting)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
